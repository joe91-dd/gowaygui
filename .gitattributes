* text=auto
*.ts text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Preserve authored archive bytes; manifests may hash them.
game/art-source/** -text -eol
game/audio-source/** -text -eol
# Git LFS holds actual binary assets; Cocos .meta stays normal versioned text.
*.png filter=lfs diff=lfs merge=lfs -text
