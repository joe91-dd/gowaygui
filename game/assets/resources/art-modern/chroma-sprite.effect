CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        portraitRect: { value: [0, 0, 1, 1] }
        portraitMotion: { value: [0, 0, 0, 0] }
        eyeA: { value: [0, 0, 0.04, 0.04] }
        eyeB: { value: [0, 0, 0.04, 0.04] }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform PortraitParams { vec4 portraitRect; vec4 portraitMotion; vec4 eyeA; vec4 eyeB; };
  float region(vec2 p, vec2 center, vec2 radius) {
    return 1.0 - smoothstep(0.55, 1.0, length((p-center)/radius));
  }
  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      vec2 sampleUV=uv0;
      vec2 p=(uv0-portraitRect.xy)/portraitRect.zw;
      float tm=portraitMotion.y>5.5?cc_time.x:portraitMotion.x, role=portraitMotion.y;
      if(role>5.5){
        vec4 base=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0);
        float sea=smoothstep(.05,.19,base.b-base.r)*smoothstep(.035,.13,base.g-base.r)*smoothstep(.36,.405,p.y)*(1.0-smoothstep(.64,.73,p.y));
        float nearWave=smoothstep(.39,.60,p.y);
        vec2 swell=vec2(sin(p.y*62.0-tm*1.25)+.38*sin(p.x*83.0+p.y*31.0-tm*2.0),cos(p.x*65.0+p.y*37.0-tm*1.5));
        sampleUV+=swell*vec2(.0032,.0017)*sea*(.42+nearWave);
      }else if(role>0.5){
        // Chest expands around its lower anchor; there is no whole-body vertical bob.
        float chest=region(p,vec2(.53,.54),vec2(.43,.39));
        p.x-=sin(tm*(role<1.5?1.65:2.15))*.0035*(p.x-.5)*chest;
        p.y+=sin(tm*(role<1.5?1.65:2.15))*.0024*chest;
        float head=region(p,vec2((eyeA.x+eyeB.x)*.5,eyeA.y+.065),vec2(.24,.20));
        p.x+=sin(tm*.67)*.0025*head;
        p.y+=sin(portraitMotion.z*6.283)*.010*head;
        // Flexible leaves and a held staff move independently of the body.
        float weapon=role>3.5&&role<4.5?region(p,vec2(.89,.46),vec2(.14,.34)):region(p,vec2(role<2.5?.78:.12,.27),vec2(.18,.30));
        if(role>1.5)p.x+=sin(tm*(role<2.5?1.9:1.3)+p.y*5.0)*.004*weapon;
        sampleUV=portraitRect.xy+p*portraitRect.zw;
      }
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, sampleUV);
      if(role>5.5){
        float sea=smoothstep(.05,.19,o.b-o.r)*smoothstep(.035,.13,o.g-o.r)*smoothstep(.36,.41,p.y)*(1.0-smoothstep(.64,.73,p.y));
        float glint=pow(.5+.5*sin(p.x*198.0+p.y*86.0-tm*2.3),18.0)*pow(.5+.5*sin(p.y*149.0-tm*1.6),6.0);
        o.rgb+=vec3(.11,.22,.24)*glint*sea;
      }
      if(role>0.5&&role<5.5){
        // Close the eyelid over the iris using nearby skin from the same artwork.
        for(int i=0;i<2;i++){
          vec4 eye=i==0?eyeA:eyeB;
          float cover=region(p,eye.xy,eye.zw)*smoothstep(.05,.8,portraitMotion.w);
          vec2 skin=vec2(p.x,eye.y-eye.w*1.35);
          vec4 lid=CCSampleWithAlphaSeparated(cc_spriteTexture,portraitRect.xy+skin*portraitRect.zw);
          float crease=1.0-smoothstep(.0015,.0045,abs(p.y-eye.y-.005-((p.x-eye.x)/eye.z)*((p.x-eye.x)/eye.z)*.008));
          lid.rgb=mix(lid.rgb,lid.rgb*.38,crease*.8);
          o.rgb=mix(o.rgb,lid.rgb,cover);
        }
        float blue=max(0.0,min(o.b,o.g)-o.r-.08);
        float jewel=role<1.5?1.0:region(p,vec2(.15,.18),vec2(.23,.25));
        o.rgb+=vec3(.12,.48,.60)*blue*jewel*(.25+.22*sin(tm*2.0+p.y*8.0));
        if(role>3.5&&role<4.5){float lamp=region(p,vec2(.88,.55),vec2(.11,.14));o.rgb+=vec3(.18,.10,.015)*lamp*(.5+.25*sin(tm*3.1)+.12*sin(tm*7.3));}
      }
      #if IS_GRAY
        float gray  = 0.2126 * o.r + 0.7152 * o.g + 0.0722 * o.b;
        o.r = o.g = o.b = gray;
      #endif
    #endif

    #if CREAM_KEY
      float creamDistance = length(o.rgb - vec3(0.99, 0.975, 0.918));
      o.a *= smoothstep(0.06, 0.22, creamDistance);
    #else
      float magenta = min(o.r, o.b) - o.g;
      float key = smoothstep(0.28, 0.50, magenta) * smoothstep(0.52, 0.74, min(o.r, o.b));
      o.a *= 1.0 - key;
      float spill = max(0.0, min(o.r, o.b) - o.g - 0.20);
      o.r -= spill * 0.65;
      o.b -= spill * 0.40;
    #endif
    o *= color;
    ALPHA_TEST(o);
    return o;
  }
}%
