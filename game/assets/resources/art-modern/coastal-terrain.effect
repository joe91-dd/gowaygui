CCEffect %{
 techniques:
 - passes:
   - vert: terrain-vs:vert
     frag: terrain-fs:frag
     rasterizerState: { cullMode: none }
     depthStencilState: { depthTest: true, depthWrite: true }
     properties:
       mainTexture: { value: white }
       themeTexture: { value: white }
       themeRect: { value: [0, 0, 1, 1] }
       roadColor: { value: [1, 1, 1, 1] }
       mainColor: { value: [1, 1, 1, 1] }
       surfaceParams: { value: [0, 3, 0, 0] }
}%
CCProgram terrain-vs %{
 precision highp float;
 #include <builtin/uniforms/cc-global>
 #include <builtin/uniforms/cc-local>
 in vec3 a_position;
 in vec2 a_texCoord;
 in vec4 a_color;
 out vec2 uv;
 out vec4 masks;
 vec4 vert(){uv=a_texCoord;masks=a_color;return cc_matProj*cc_matView*cc_matWorld*vec4(a_position,1.0);}
}%
CCProgram terrain-fs %{
 precision highp float;
 in vec2 uv;
 in vec4 masks;
 uniform sampler2D mainTexture;
 uniform sampler2D themeTexture;
 uniform TerrainParams { vec4 mainColor; vec4 surfaceParams; vec4 themeRect; vec4 roadColor; };
 vec3 tile(float i,vec2 p){vec2 f=abs(fract(p*.5)*2.0-1.0);f=f*.96+.02;return texture(mainTexture,(vec2(mod(i,3.0),floor(i/3.0))+f)/vec2(3.0,2.0)).rgb;}
 vec4 frag(){
  float dist=masks.r*1.05,coast=masks.g;
  if(surfaceParams.z>.5){
   vec3 ground=texture(themeTexture,themeRect.xy+clamp(uv,vec2(0.0),vec2(1.0))*themeRect.zw).rgb;
   vec3 grain=tile(3.0,uv*vec2(8.0,4.5));
   float noise=(grain.r+grain.g+grain.b)/3.0;
   float shoulder=1.0-smoothstep(.52,.62,dist+(noise-.65)*.035);
   vec3 road=roadColor.rgb*(.88+noise*.18);
   road*=1.0-.12*exp(-pow((dist-.50)/.045,2.0));
   road+=vec3(.045,.035,.019)*exp(-pow((dist-.42)/.026,2.0));
   return vec4(mix(ground,road,shoulder),1.0);
  }
  vec3 grassBase=surfaceParams.x<.5?vec3(.55,.67,.38):surfaceParams.x<1.5?vec3(.41,.56,.42):vec3(.55,.68,.49);
  vec3 grass=mix(grassBase,tile(surfaceParams.x,uv*.62),.20),sand=tile(3.0,uv*1.14),road=tile(surfaceParams.y,uv*1.1);
  grass*=.985+.015*sin(uv.x*.8+uv.y*.7);
  float noise=dot(grass,vec3(.21,.71,.08))-.45;
  float edge=smoothstep(.44,.61,dist+noise*.035);
  vec3 ground=mix(road,grass,edge);
  // Soil trough, broken grassy shoulder and sunlit inner lip occupy one surface.
  float bank=exp(-pow((dist-.53)/.045,2.0));
  ground*=1.0-bank*.18;
  ground+=vec3(.035,.026,.012)*exp(-pow((dist-.44)/.025,2.0));
  ground=mix(ground,sand,smoothstep(.015,.30,coast));
  vec3 rock=tile(4.0,uv*1.55)*vec3(.74,.75,.72);
  float strata=.91+.09*sin(coast*34.0+uv.x*1.4);
  ground=mix(ground,rock*strata*masks.b,smoothstep(.36,.72,coast));
  return vec4(ground*mainColor.rgb,1.0);
 }
}%
