CCEffect %{
  techniques:
  - passes:
    - vert: battle-vs:vert
      frag: battle-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: true }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
      properties:
        mainTexture: { value: white }
        mainColor: { value: [1, 1, 1, 1] }
        keyParams: { value: [0, 0, 0, 0] }
        surfaceRect: { value: [0, 0, 1, 1] }
}%
CCProgram battle-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec2 a_texCoord;
  out vec2 uv;
  uniform PaintParams { vec4 mainColor; vec4 keyParams; vec4 surfaceRect; };
  vec4 vert () {
    uv = a_texCoord;
    vec3 pos=a_position;
    if(keyParams.x>6.5&&keyParams.x<7.5){
      float stride=keyParams.z,side=pos.x<0.0?-1.0:1.0,step=sin(stride+side*1.5708)*keyParams.y;
      float leg=1.0-smoothstep(.05,.50,max(0.0,pos.y));
      pos.x+=step*.055*leg;pos.y+=max(0.0,step)*.075*leg;
      pos.x+=sin(stride)*.020*smoothstep(.1,1.3,pos.y)*keyParams.y;
      pos.y-=abs(sin(stride))*.018*smoothstep(.2,.65,pos.y)*keyParams.y;
    }
    return cc_matProj * cc_matView * cc_matWorld * vec4(pos, 1.0);
  }
}%
CCProgram battle-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec2 uv;
  uniform sampler2D mainTexture;
  uniform PaintParams { vec4 mainColor; vec4 keyParams; vec4 surfaceRect; };
  vec4 frag () {
    if (keyParams.x < -0.5) return mainColor;
    if(keyParams.x>5.5&&keyParams.x<6.5){
      vec2 p=(uv-.5)*2.0;float r=length(p),a=atan(p.y,p.x),t=keyParams.z;
      float rim=exp(-pow((r-.81)/.019,2.0));
      float arcs=pow(.5+.5*cos(a*3.0-t*.42),10.0);
      float stream=pow(.5+.5*cos(a-t*.75),22.0)*exp(-pow((r-.81)/.041,2.0));
      float alpha=rim*(.07+arcs*.13)+stream*.19;if(alpha<.025)discard;
      return vec4(mix(mainColor.rgb,vec3(.90,.91,.79),stream*.34),alpha);
    }

    if(keyParams.x>4.5&&keyParams.x<5.5){
      vec2 p=(uv-.5)*2.0;float r=length(p),a=atan(p.y,p.x),t=keyParams.z,style=keyParams.y;
      float fade=smoothstep(0.0,.15,t)*(1.0-smoothstep(.8,1.0,keyParams.w));
      vec3 rgb=vec3(0.0);float alpha=0.0;
      if(style>6.5){
        float ring=exp(-pow((r-.70)/.025,2.0)),inner=exp(-pow((r-.40)/.019,2.0));
        float runes=pow(.5+.5*cos(a*8.0-t*1.2),14.0)*exp(-pow((r-.56)/.075,2.0));
        float wake=exp(-pow((r-fract(t*.8))/.055,2.0))*(1.0-r)*.42;
        rgb=vec3(.57,.36,1.0)*(ring+inner*.55+runes*.65+wake)+vec3(.75,.87,1.0)*pow(runes,2.0)*.70;alpha=max(ring*.72,max(inner*.40,runes*.68))+wake;
      }else if(style>5.5){
        float curl=pow(.5+.5*cos(a*3.0+r*10.0-t*5.0),25.0)*exp(-pow((r-.55)/.35,2.0));
        float rim=exp(-pow((r-.78)/.027,2.0))*(.25+.22*sin(a*4.0-t*3.0));
        rgb=vec3(.20,.68,.92)*curl+vec3(.64,.92,1.0)*rim;alpha=max(curl*.6,rim);
        for(int i=0;i<24;i++){float f=float(i),v=fract(t*.9+f*.051);vec2 center=vec2(sin(f*2.39),cos(f*3.17))*.72;vec2 q=p-center-vec2(-.12,-.44)*(1.0-v);float crystal=(1.0-smoothstep(.021,.039,abs(q.x)+abs(q.y)*.45))*sin(v*3.14159);float trail=exp(-pow(q.x/.011,2.0))*exp(-pow((q.y+.11)/.15,2.0))*sin(v*3.14159);rgb+=vec3(.77,.96,1.0)*(crystal+trail*.28);alpha=max(alpha,max(crystal,trail*.25));}
      }else if(style>4.5){float wave=exp(-pow((r-keyParams.w*.95)/.055,2.0));float spokes=pow(.5+.5*cos(a*8.0+r*4.0),24.0)*(1.0-smoothstep(.1,.8,r));rgb=vec3(.97,.67,.33)*(wave+spokes*.7);alpha=max(wave*.7,spokes*.7);
      }else if(style>3.5){float edge=exp(-pow((r-.94)/.018,2.0)),sweep=step(r,keyParams.w*.92)*.12,marks=pow(.5+.5*cos(a*12.0),8.0)*exp(-pow((r-.86)/.04,2.0));rgb=vec3(1.0,.36,.18);alpha=max(edge*.8,marks*.5)+sweep;fade=1.0;
      }else if(style<.5){
        float arc=pow(.5+.5*sin(a*3.0-r*11.0+t*8.0),18.0)*exp(-pow((r-.62)/.24,2.0));
        float dust=pow(.5+.5*cos(a*7.0+r*23.0-t*4.0),9.0)*exp(-pow((r-.82)/.11,2.0));rgb+=vec3(.83,.72,.52)*dust*.35;alpha=dust*.22;
        rgb+=vec3(.22,.64,.86)*arc*.65;alpha=max(alpha,arc*.62);
        for(int i=0;i<9;i++){
          float f=float(i),angle=f*.698+t*(2.5+mod(f,2.0)*.25),radius=.56+sin(f*3.7+t*1.4)*.18;
          vec2 q=(p-vec2(cos(angle),sin(angle))*radius)/(.074+mod(f,3.0)*.012);
          float c=cos(angle*2.0),s=sin(angle*2.0);q=vec2(c*q.x-s*q.y,s*q.x+c*q.y);
          float rock=1.0-smoothstep(.81,1.0,max(abs(q.x)*.80+abs(q.y)*.45,abs(q.y)));
          vec3 stone=mod(f,4.0)<.5?vec3(.17,.68,.90):vec3(.70,.55,.34);
          stone*=clamp(1.15-q.y*.25-q.x*.12,.6,1.5);rgb=mix(rgb,stone,rock);alpha=max(alpha,rock);
        }
      }else if(style<1.5){
        for(int i=0;i<12;i++){float f=float(i),v=fract(t*1.6+f*.0833);vec2 center=vec2(sin(f*2.39)*.70,cos(f*3.79)*.65);vec2 d=p-center-vec2(-.10,-.26)*(1.0-v);float line=exp(-d.x*d.x/ .00016)*exp(-pow((d.y+.08)/.15,2.0))*sin(v*3.14159);float tip=(1.0-smoothstep(.015,.03,abs(d.x)+abs(d.y)*.6))*sin(v*3.14159);rgb+=vec3(.42,.88,.24)*(line*.7+tip);alpha=max(alpha,max(line*.7,tip));}
      }else if(style<2.5){
        float ring=exp(-pow((r-(.2+keyParams.w*.65))/.035,2.0));float rays=pow(.5+.5*cos(a*6.0),22.0)*(1.0-smoothstep(.1,.85,r));rgb=vec3(.54,.88,1.0)*(ring*.65+rays*.60);alpha=max(ring*.5,rays*.65);
      }else{
        float ring=exp(-pow((r-(.15+keyParams.w*.75))/.028,2.0));float halo=exp(-r*r*8.0);rgb=vec3(1.0,.77,.30)*(ring*.7+halo*.55);alpha=max(ring*.6,halo*.45);
      }
      alpha*=fade;if(alpha<.02)discard;return vec4(rgb,alpha);
    }
    if (keyParams.x > 3.5&&keyParams.x<4.5) return texture(mainTexture, keyParams.yz + fract(uv) * keyParams.w) * mainColor;
    if (keyParams.x > 2.5&&keyParams.x<3.5) {
      float radius = length((uv - vec2(0.5)) * 2.0);
      float alpha = exp(-radius*radius*6.5)*.62 + exp(-radius*radius*2.4)*.16;
      if (alpha < 0.01) discard;
      return vec4(0.12, 0.16, 0.13, alpha);
    }
    vec2 flowUV=uv;vec4 base=texture(mainTexture,uv);
    vec2 localUV=(uv-surfaceRect.xy)/surfaceRect.zw;
    // Cool stone and ice are not water. The sea mask is also confined to the outside shore.
    float chroma=smoothstep(.22,.43,min(base.g,base.b)-base.r)*smoothstep(.54,.78,base.g)*smoothstep(.69,.85,base.g/max(base.b,.001));
    vec2 island=abs(localUV-.5)/vec2(.43,.44);
    float shore=keyParams.y>1.5&&keyParams.y<3.5?smoothstep(.96,1.16,pow(island.x,4.0)+pow(island.y,4.0)):1.0;
    float water=chroma*shore;
    if(keyParams.x<.5&&keyParams.w>.5){
      flowUV+=vec2(sin(localUV.y*72.0-cc_time.x*1.1)+sin(localUV.x*49.0+localUV.y*32.0-cc_time.x*1.7)*.4,cos(localUV.x*65.0+localUV.y*37.0-cc_time.x*1.3))*vec2(.0038,.0024)*surfaceRect.zw*water;
      flowUV=clamp(flowUV,surfaceRect.xy+.0007,surfaceRect.xy+surfaceRect.zw-.0007);
    }
    vec4 c=texture(mainTexture,flowUV);
    if(keyParams.x<.5&&keyParams.w>.5){
      float caustic=pow(.5+.5*sin(localUV.x*154.0+localUV.y*95.0-cc_time.x*1.5),14.0)*pow(.5+.5*sin(localUV.y*162.0-cc_time.x*1.1),6.0);
      c.rgb+=vec3(.09,.17,.18)*caustic*water;
      if(keyParams.y>2.5){float gem=smoothstep(.28,.48,c.b-c.r)*smoothstep(.55,.9,c.b)*(1.0-water);float pulse=pow(.5+.5*sin(cc_time.x*1.8-localUV.y*19.0-localUV.x*8.0),3.0);c.rgb+=vec3(.11,.35,.51)*gem*pulse;}
    }
    if(keyParams.x>7.5){float gem=smoothstep(.10,.35,c.b-c.r)*smoothstep(.38,.8,c.b)*(1.0-smoothstep(.2,.5,min(c.r,c.b)-c.g));float lava=smoothstep(.24,.5,c.r-c.b)*smoothstep(.5,.85,c.r);float flow=pow(.5+.5*sin(uv.y*143.0-cc_time.x*2.4),4.0);c.rgb+=vec3(.19,.39,.54)*gem*(.20+flow*.65)+vec3(.55,.20,.01)*lava*flow*.45;}
    if (keyParams.x > 1.5&&keyParams.x<2.5) {
      float a = max(c.r, max(c.g, c.b));
      c.rgb /= max(a, 0.001);
      c.a *= a;
    } else if (keyParams.x > 0.5) {
      float magenta = min(c.r, c.b) - c.g;
      c.a *= 1.0 - smoothstep(0.25, 0.48, magenta) * smoothstep(0.50, 0.73, min(c.r, c.b));
      float spill = max(0.0, min(c.r, c.b) - c.g - 0.2);
      c.r -= spill * 0.65;
      c.b -= spill * 0.4;
    }
    c *= mainColor;
    if (keyParams.x<.5&&keyParams.y>.5&&keyParams.y<1.5) {
      float edge = min(min(uv.x, 1.0-uv.x), min(uv.y, 1.0-uv.y));
      c.rgb = mix(vec3(0.321569, 0.741176, 0.815686), c.rgb, smoothstep(0.0, 0.035, edge));
    }
    if (c.a < 0.035) discard;
    return c;
  }
}%
